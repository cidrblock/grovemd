[Unit]
Description=Grove MCP (Markdown notes for Home Bot / Open WebUI)
After=network-online.target
Wants=network-online.target

[Container]
# Built from mcp/ in this repo: the code and its uv environment are baked in, so only the
# notes data is mounted. Deployed as localhost/grove-mcp:<tag> by homelab.services.grove.
Image=localhost/grove-mcp:0.1.0
ContainerName=grove-mcp
PublishPort=127.0.0.1:3093:8000
# Same notes tree as Grove UI
Volume=/mnt/space16/grove-data:/data
Environment=DATA_ROOT=/data
WorkingDir=/app
Network=home-chat.network
UserNS=keep-id:uid=1000,gid=1000
SecurityLabelDisable=true
Entrypoint=["uv"]
Exec=run --directory /app grove-mcp --transport streamable-http --host 0.0.0.0 --port 8000

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
