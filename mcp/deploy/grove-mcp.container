[Unit]
Description=Grove MCP (Markdown notes for Home Bot / Open WebUI)
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/astral-sh/uv:python3.13-bookworm-slim
ContainerName=grove-mcp
PublishPort=127.0.0.1:3093:8000
# Source lives in the grovemd monorepo (mcp/)
Volume=/var/home/bthornto/github/grovemd/mcp:/app
# Same notes tree as Grove UI — run as host user, no SELinux relabel
Volume=/var/home/bthornto/Documents/Grove:/data
Environment=DATA_ROOT=/data
WorkingDir=/app
Network=home-chat.network
UserNS=keep-id:uid=1000,gid=1000
SecurityLabelDisable=true
Entrypoint=["uv"]
Exec=run --directory /app grove-mcp --transport streamable-http --host 0.0.0.0 --port 8000

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
