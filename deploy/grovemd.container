[Unit]
Description=Grove Markdown workspace
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=grovemd
Image=localhost/grovemd:latest
PublishPort=127.0.0.1:8096:8080
# Notes on space16 (same pattern as other house services). No :Z — keep
# host-owned files so mv/cp into the tree works without SELinux fights.
Volume=/mnt/space16/grove-data:/data
Environment=DATA_ROOT=/data
Environment=STATIC_DIR=/app/frontend/dist
UserNS=keep-id:uid=1000,gid=1000
SecurityLabelDisable=true

[Service]
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
